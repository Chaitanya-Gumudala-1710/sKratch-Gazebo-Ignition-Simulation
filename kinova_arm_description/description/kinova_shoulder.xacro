<?xml version="1.0"?>
<robot name="kinova_shoulder" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="kinova_shoulder">
        <link name="kinova_shoulder">
            <inertial>
                <origin xyz="0.0 0.009 0.08" rpy="0.0 0.0 0.0" />
                <mass value="1.3773" />
                <inertia ixx="0.00457" ixy="0.0" ixz="0.0" iyy="0.004831" iyz="0.0" izz="0.001409" />
            </inertial>
            <visual>
                <origin xyz="0.009 -0.009 0" rpy="1.57 -1.57 -1.57" />
                <geometry>
                    <mesh filename="file://$(find kinova_arm_description)/meshes/kinova_shoulder.stl" scale="0.001 0.001 0.001"/>
                </geometry>
                <material name="carbon_fiber">
                    <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1" />
                </material>
            </visual>
            <collision>
                <origin xyz="0.009 -0.009 0" rpy="1.57 -1.57 -1.57" />
                <geometry>
                    <mesh filename="file://$(find kinova_arm_description)/meshes/kinova_shoulder.stl" scale="0.001 0.001 0.001"/>
                </geometry>
            </collision>
        </link>
        <gazebo reference="kinova_shoulder">
            <material>Gazebo/LightBlue</material>
        </gazebo>
    </xacro:macro>
</robot>