<?xml version="1.0"?>
<robot name="kinova_fore_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="kinova_fore_arm">
        <link name="kinova_fore_arm">
            <inertial>
                <origin xyz="0.0 -0.008 0.1" rpy="0.0 0.0 0.0" />
                <mass value="0.9302" />
                <inertia ixx="0.008147" ixy="0" ixz="0" iyy="0.008316" iyz="0" izz="0.000631" />
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="3.14 -1.57 0" />
                <geometry>
                    <mesh filename="file://$(find kinova_arm_description)/meshes/kinova_fore_arm.stl" scale="0.001 0.001 0.001"/>
                </geometry>
                <material name="carbon_fiber">
                    <color rgba="0.792156862745098 0.819607843137255 0.933333333333333 1" />
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="3.14 -1.57 0" />
                <geometry>
                    <mesh filename="file://$(find kinova_arm_description)/meshes/kinova_fore_arm.stl" scale="0.001 0.001 0.001"/>
                </geometry>
            </collision>
        </link>
        <gazebo reference="kinova_fore_arm">
            <material>Gazebo/LightBlue</material>
        </gazebo>
    </xacro:macro>
</robot>